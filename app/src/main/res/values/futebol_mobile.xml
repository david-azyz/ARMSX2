<?xml version="1.0" encoding="utf-8"?>
<!--
  Futebol Mobile: tudo o que você pode personalizar fica neste arquivo.
  - Nome do app na tela inicial: fm_app_name
  - Textos dos botões: fc_label_*
  - Tamanho dos botões: fc_btn_*
  - Tamanho e posição do analógico: fc_stick_*
  - No jogo, o menu (botão no topo) tem o controle "Tamanho dos controles"
-->
<resources>
    <!-- Nome que aparece embaixo do ícone no celular -->
    <string name="fm_app_name" translatable="false">PathZz2</string>

    <!-- Rótulos dos botões (ataque). Ajuste se o seu jogo usar outra função. -->
    <string name="fc_label_shoot" translatable="false">CHUTE</string>
    <string name="fc_label_pass" translatable="false">PASSE</string>
    <string name="fc_label_through" translatable="false">ENFIADA</string>
    <string name="fc_label_cross" translatable="false">CRUZAR</string>
    <string name="fc_label_sprint" translatable="false">CORRER</string>
    <string name="fc_label_switch" translatable="false">TROCAR</string>
    <!-- Nomes na defesa (sem a bola) -->
    <string name="fc_label_def_shoot" translatable="false">CERCAR</string>
    <string name="fc_label_def_pass" translatable="false">PRESSIONAR</string>
    <string name="fc_label_def_through" translatable="false">GOLEIRO</string>
    <string name="fc_label_def_cross" translatable="false">CARRINHO</string>
    <!-- Detector de posse de bola -->
    <string name="fc_poss_button" translatable="false">Posse de bola (ataque/defesa)</string>
    <string name="fc_poss_detect" translatable="false">Detectar posse de bola</string>
    <string name="fc_poss_invert" translatable="false">Inverter ataque/defesa</string>
    <string name="fc_poss_auto_on" translatable="false">Ligar troca automática</string>
    <string name="fc_poss_auto_off" translatable="false">Desligar troca automática</string>
    <string name="fc_poss_hint" translatable="false">Jogue e toque no botão certo: COM A BOLA quando seu time tiver a bola, SEM A BOLA quando o adversário tiver. Faça umas 3 vezes cada.</string>
    <string name="fc_poss_with" translatable="false">COM A BOLA</string>
    <string name="fc_poss_without" translatable="false">SEM A BOLA</string>
    <string name="fc_poss_restart" translatable="false">Recomeçar</string>
    <string name="fc_poss_done" translatable="false">Concluir</string>
    <string name="fc_poss_status" translatable="false">Com a bola: %1$d · Sem a bola: %2$d · Possíveis: %3$s</string>
    <string name="fc_poss_ok" translatable="false">Pronto! Os controles agora trocam sozinhos entre ataque e defesa.</string>
    <string name="fc_poss_many" translatable="false">Ainda tem muitas possibilidades (%1$d). Marque mais algumas vezes antes de concluir.</string>
    <string name="fc_poss_none" translatable="false">Não achei. Toque em Recomeçar e tente de novo, marcando só quando estiver bem claro quem tem a bola.</string>
    <string name="fc_poss_not_ready" translatable="false">Marque pelo menos uma vez COM A BOLA e uma vez SEM A BOLA.</string>
    <string name="fc_mode_name" translatable="false">Futebol (estilo mobile)</string>
    <string name="fc_scale_label" translatable="false">Tamanho dos controles</string>
    <string name="fc_alpha_label" translatable="false">Transparência dos controles</string>
    <string name="fc_sizes_button" translatable="false">Tamanho de cada botão</string>
    <string name="fc_sizes_title" translatable="false">Tamanho de cada botão</string>
    <string name="fc_sizes_reset" translatable="false">Restaurar</string>
    <string name="fc_sizes_done" translatable="false">Pronto</string>
    <string name="fc_move_button" translatable="false">Mover controles</string>
    <string name="fc_move_hint" translatable="false">Arraste os controles para onde quiser</string>
    <string name="fc_move_reset" translatable="false">Restaurar</string>
    <string name="fc_move_done" translatable="false">Concluir</string>

    <!-- Menu de pausa (botão voltar do celular) -->
    <string name="fc_pause_title" translatable="false">Jogo pausado</string>
    <string name="fc_pause_continue" translatable="false">Continuar</string>
    <string name="fc_pause_exit" translatable="false">Sair do jogo</string>
    <string name="fc_pause_options" translatable="false">Opções</string>
    <string name="fc_pause_face_fix" translatable="false">Corrigir rosto dos jogadores no replay</string>
    <string name="fc_face_fix_restart" translatable="false">A correção do rosto vale quando você abrir o jogo de novo.</string>

    <!-- Mensagens do modo jogo único -->
    <string name="fm_pick_iso" translatable="false">Escolha a ISO do jogo. Isso só é pedido na primeira vez.</string>
    <string name="fm_iso_missing" translatable="false">Não encontrei a ISO. Escolha o arquivo de novo.</string>

    <!-- Apertar X (passe/pressão) também aperta R1 (correr). Atraso em ms: 0 = instantâneo. -->
    <bool name="fc_x_hold_sprint">true</bool>
    <integer name="fc_x_hold_delay_ms">0</integer>

    <!-- Tamanhos -->
    <dimen name="fc_btn_shoot">92dp</dimen>
    <dimen name="fc_btn_pass">80dp</dimen>
    <dimen name="fc_btn_small">68dp</dimen>
    <dimen name="fc_btn_sprint">72dp</dimen>
    <dimen name="fc_btn_switch">60dp</dimen>
    <dimen name="fc_stick_size">150dp</dimen>
    <dimen name="fc_stick_margin_start">28dp</dimen>
    <dimen name="fc_stick_margin_bottom">20dp</dimen>

    <!-- Estilo dos rótulos embaixo dos botões -->
    <style name="FcButtonLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-4dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
